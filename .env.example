# --- Azure AI Foundry (Claude Sonnet deployment) ---
# Project / resource endpoint shown on the Foundry portal, e.g.
#   https://my-resource.services.ai.azure.com/api/projects/my-project
# (the client derives the Anthropic-compatible /anthropic route from it)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_FOUNDRY_API_KEY=replace-with-foundry-api-key
# Name you gave the Claude Sonnet deployment in Foundry
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=claude-sonnet

# --- Supabase (backend only, never sent to the browser) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Backend behaviour ---
# Comma-separated list of browser origins allowed to call the API (REST and WebSocket)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hard cap on LangGraph super-steps per run
MAX_GRAPH_STEPS=30
# Budget re-planning attempts per turn, and chat turns allowed per client per minute (0 disables the limiter)
MAX_BUDGET_REVISIONS=4
RATE_LIMIT_PER_MINUTE=20
# Reverse proxies in front of the API (Azure Container Apps ingress = 1); the client address is read that far from the right of X-Forwarded-For
TRUSTED_PROXY_HOPS=1

# --- Frontend (read at container start, not baked into the bundle) ---
# Public URL the browser uses to reach the FastAPI backend
API_URL=http://localhost:8000
